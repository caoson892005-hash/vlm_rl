<?xml version="1.0"?>
<sdf version="1.7">
  <model name="person">
    <static>false</static>
    <self_collide>false</self_collide>
    <allow_auto_disable>false</allow_auto_disable>
    <link name="body">
      <!-- The controller sets poses directly, so keep the actor kinematic. -->
      <gravity>false</gravity>
      <kinematic>true</kinematic>

      <!-- A simple collision body is much cheaper and more stable than using
           the detailed human mesh for six moving people. -->
      <collision name="body_collision">
        <pose>0 0 0.9 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.28</radius>
            <length>1.8</length>
          </cylinder>
        </geometry>
      </collision>

      <!-- Textured MakeHuman model used by Gazebo's "Walking person" asset. -->
      <visual name="person_visual">
        <!-- walking.dae's visual forward axis is 90 degrees from Gazebo's +X.
             Rotate only the rendered mesh so entity yaw remains the gaze yaw. -->
        <pose>0 0 -0.02 0 0 1.5707963267948966</pose>
        <geometry>
          <mesh>
            <uri>model://person/meshes/walking.dae</uri>
          </mesh>
        </geometry>
      </visual>
    </link>
  </model>
</sdf>
