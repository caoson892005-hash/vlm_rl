<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro">
  <xacro:property name="base_length" value="0.20" />
  <xacro:property name="base_width" value="0.20" />
  <xacro:property name="base_height" value="0.18852" />
  <xacro:property name="base_mass" value="2.5" />

  <xacro:property name="wheel_radius" value="0.0325" />
  <xacro:property name="wheel_width" value="0.027" />
  <xacro:property name="wheel_pos_x" value="0.0" />
  <xacro:property name="wheel_pos_y" value="0.10688" />
  <xacro:property name="wheel_pos_z" value="0.0325" />
  <xacro:property name="wheel_mass" value="0.7181" />
  <xacro:property name="wheel_torque" value="0.43" />
  <xacro:property name="front_caster_wheel" value="false" />
  <xacro:property name="rear_caster_wheel" value="false" />
  <xacro:property name="wheel_coast" value="-0.0263800000000001" />

  <xacro:property name="laser_pose">
    <origin xyz="0.00669528741938097 -7.83717636255732E-05 0.19525868699062" rpy="0 0 0"/>
  </xacro:property>

  <!-- RGB-D camera carried by the robot, on the front edge of the base cover.
       This is the only camera the social pipeline reads, so the three numbers
       matter:
         z = 0.2225 in base_link is 0.255 m above the ground, and it puts the
             camera box (0.030 tall) entirely ABOVE the lidar plane at
             z = 0.19526. Mounting it level with the lidar would make the
             camera its own permanent obstacle in /scan.
         x = 0.10  is the front edge of the 0.20 m base, clear of the lidar
             body (radius 0.04).
         pitch = -0.20 rad tilts it 11.5 deg UP. At 3 m the 87 x 70 deg frustum
             then covers the ground up to 3.4 m high, i.e. two whole people; at
             1.5 m it reaches 1.83 m, chest to neck. Closer than ~1.0 m their
             heads leave the frame, which is what the VLM needs, so keep the
             conversation pair at 1.5 m or more. -->
  <xacro:property name="depth_sensor_pose">
    <origin xyz="0.10 0.0 0.2225" rpy="0 -0.20 0"/>
  </xacro:property>

  <!-- Unused -->
  <xacro:property name="rear_camera_sensor_pose">
    <origin xyz="-0.14 0.0 0.045" rpy="0 0 3.14159"/>
  </xacro:property>
  <!-- Unused -->

</robot>